# Copy to .env and set your Supabase project's public URL and publishable key.
# Never place a service-role key in the backend or frontend environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_IMAGE_BUCKET=crop-scans
CORS_ORIGINS=http://localhost:3000

